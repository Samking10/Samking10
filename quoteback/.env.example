# Copy to .env for local development: cp .env.example .env
# Every setting has a safe default; only change what you need.

# --- App ---
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=data/quoteback.db
# Comma-separated logins that can open /admin
ADMIN_EMAILS=you@example.com
SUPPORT_EMAIL=you@example.com

# --- Pricing (all amounts in cents) ---
PLAN_NAME=QuoteBack
PLAN_PRICE_CENTS=29900
ONBOARDING_FEE_CENTS=29900
ONBOARDING_FEE_ENABLED=true
MAX_ACTIVE_ESTIMATES=250
MAX_LOCATIONS=1
TRIAL_DAYS=0
CURRENCY=usd

# --- Billing: "manual" (you invoice, then switch accounts on in /admin) or "stripe" ---
BILLING_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email: "log" (nothing sent; read emails at /dev/outbox), "postmark", or "resend" ---
EMAIL_TRANSPORT=log
FROM_EMAIL=followups@example.com
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
RESEND_API_KEY=

# --- Reply detection (Postmark inbound). Leave INBOUND_DOMAIN empty to turn it off. ---
INBOUND_DOMAIN=
INBOUND_WEBHOOK_SECRET=

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
MIN_HOURS_BETWEEN_EMAILS=20
MAX_SEND_ATTEMPTS=4
