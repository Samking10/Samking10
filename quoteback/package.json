{
  "name": "quoteback",
  "version": "1.0.0",
  "private": true,
  "description": "Estimate follow-up for small painting contractors",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "tick": "node --env-file-if-exists=.env scripts/tick.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3"
  }
}
